STUDENT_ID=402102657
STUDENT_NAME="Parsa Nikookalam"

TARGET=wsl

HTTP_PORT=8080
HTTPS_PORT=8443
DETECTOR_PORT=5000
GATEWAY_PORT=8000

STREAM_HOST=127.0.0.1
STREAM_PORT=5000

CAMERA_MODE=device
CAMERA_INDEX=0
CAMERA_IDLE_RELEASE_SEC=2.5

# Body (YOLOv8n person) confidence — lower = more detections
DNN_CONF=0.35
YOLO_INPUT=640
YOLO_NMS=0.45
# Face (YuNet) confidence
FACE_CONF=0.55

# WSL: Windows helper writes this file (see scripts/windows/setup_host_temp_task.ps1)
# HOST_CPU_TEMP_FILE=/mnt/c/Users/YOURUSER/AppData/Local/SmartGuard/cpu_temp.txt

# --- Part 3B: Gmail email alerts (C / libcurl) ---
# 1) Create a Google App Password (see guide from assistant)
# 2) Fill SMTP_USER / SMTP_PASS / EMAIL_TO
# 3) Set EMAIL_ENABLED=1 and restart web_server
EMAIL_ENABLED=1
SMTP_URL=smtps://smtp.gmail.com:465
SMTP_USER=parsanikookalam@gmail.com
# No spaces (systemd EnvironmentFile breaks on spaces). Same 16-char App Password.
SMTP_PASS=qmziityqvkewzflm
EMAIL_FROM=parsanikookalam@gmail.com
EMAIL_TO=cloudeparsa@gmail.com
EMAIL_DEBOUNCE_SEC=30

# --- Part 3C: MQTT (C client → Mosquitto on this PC) ---
MQTT_ENABLED=1
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=smartguard
MQTT_PASS=smartguard
MQTT_INTERVAL_SEC=2

# --- Part 4 ---
# Thermal: your idle~67, load~88-95 → throttle at 85, clear under 78
THERMAL_TEMP_C=85
THERMAL_CLEAR_C=78
WATCHDOG_SEC=30
